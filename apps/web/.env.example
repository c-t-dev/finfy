# Copy to apps/web/.env.local. All variables are optional in development.

# Public name and origin (canonical and hreflang links of the public pages).
NEXT_PUBLIC_APP_NAME=finfy
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres. `pnpm db:up` starts this one with Docker (docker-compose.yml).
DATABASE_URL=postgres://finfy:finfy@localhost:5432/finfy

# Secret HMAC key applied to passwords and one-time codes before hashing.
# Required for sign-up and login. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PASSWORD_PEPPER_V1=

# Who can sign up: `open` (anyone) or `invite` (needs a code made in Settings by
# an existing account; the first account never needs one). Default: open.
SIGN_UP_MODE=open
