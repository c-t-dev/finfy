# Copy to apps/web/.env.local. All variables are optional in development.

# Public name and origin (canonical and hreflang links of the public pages).
NEXT_PUBLIC_APP_NAME=finfy
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres. `pnpm db:up` starts this one with Docker (docker-compose.yml).
DATABASE_URL=postgres://finfy:finfy@localhost:5432/finfy
